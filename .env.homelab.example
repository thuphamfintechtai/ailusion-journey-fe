# cp .env.homelab.example .env.homelab
# Chạy: docker compose --env-file .env.homelab -f compose.homelab.yaml up -d --build
# Đổi URL thì phải build lại, vì NEXT_PUBLIC_* gắn lúc build.

TRAEFIK_NETWORK=traefik_net
TRAEFIK_ENTRYPOINT=websecure
WEB_HOST=journey.ailusion.io.vn
WEB_HOST_PORT=3000

NEXT_PUBLIC_APP_URL=https://journey.ailusion.io.vn
NEXT_PUBLIC_API_URL=https://journey-api.ailusion.io.vn
# Để trống thì bản đồ lộ trình dùng OpenFreeMap.
NEXT_PUBLIC_VIETMAP_KEY=
