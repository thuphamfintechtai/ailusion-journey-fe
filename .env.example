# Copy to .env.local for local dev. Never commit real secrets.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser and inlined at build time.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Backend (repo ailusion-journey-be). Chạy bằng `make dev` bên đó.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Key Vietmap để hiện bản đồ lộ trình (https://maps.vietmap.vn/console). Key lộ ra trình duyệt:
# giới hạn tên miền trong console. Để trống thì dùng bản đồ OpenFreeMap.
NEXT_PUBLIC_VIETMAP_KEY=

# Mã truy vết (debug): trang project LangSmith / Langfuse để dựng link tới trace của từng chat và
# lộ trình. Bỏ trống thì chỉ hiện mã, không hiện link.
# VD https://smith.langchain.com/o/<tổ chức>/projects/p/<project>
NEXT_PUBLIC_LANGSMITH_PROJECT_URL=
# VD https://us.cloud.langfuse.com/project/<project>
NEXT_PUBLIC_LANGFUSE_PROJECT_URL=
